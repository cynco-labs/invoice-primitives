{
  "name": "@invoice-primitives/convex",
  "version": "0.0.0",
  "description": "Invoicing as a Convex component.",
  "keywords": [
    "invoicing",
    "invoice",
    "convex",
    "convex-component",
    "e-invoicing"
  ],
  "homepage": "https://github.com/cynco-labs/invoice-primitives/tree/main/packages/convex#readme",
  "bugs": {
    "url": "https://github.com/cynco-labs/invoice-primitives/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cynco-labs/invoice-primitives.git",
    "directory": "packages/convex"
  },
  "license": "Apache-2.0",
  "author": "Cynco Labs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/client/index.ts",
    "./convex.config": "./src/component/convex.config.ts",
    "./convex.config.js": "./src/component/convex.config.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "./convex.config": {
        "types": "./dist/component/convex.config.d.ts",
        "default": "./dist/component/convex.config.js"
      },
      "./convex.config.js": {
        "types": "./dist/component/convex.config.d.ts",
        "default": "./dist/component/convex.config.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@invoice-primitives/core": "workspace:*",
    "convex": "^1.48.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex-test": "^0.0.65",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
