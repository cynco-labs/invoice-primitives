{
  "name": "@invoice-primitives/cloudflare",
  "version": "0.0.0",
  "description": "Invoicing on Cloudflare: one Durable Object per tenant, with SQLite storage.",
  "keywords": [
    "invoicing",
    "invoice",
    "cloudflare",
    "workers",
    "durable-objects",
    "e-invoicing"
  ],
  "homepage": "https://github.com/cynco-labs/invoice-primitives/tree/main/packages/cloudflare#readme",
  "bugs": {
    "url": "https://github.com/cynco-labs/invoice-primitives/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cynco-labs/invoice-primitives.git",
    "directory": "packages/cloudflare"
  },
  "license": "Apache-2.0",
  "author": "Cynco Labs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typegen": "wrangler types",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@invoice-primitives/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
