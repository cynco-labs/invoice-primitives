{
  "name": "@invoice-primitives/core",
  "version": "0.0.0",
  "description": "Exact, versioned invoicing primitives: calculation, lifecycle, settlement, presentation.",
  "keywords": [
    "invoicing",
    "invoice",
    "e-invoicing",
    "en16931",
    "peppol",
    "myinvois",
    "tax",
    "money",
    "decimal",
    "accounting"
  ],
  "homepage": "https://github.com/cynco-labs/invoice-primitives/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/cynco-labs/invoice-primitives/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cynco-labs/invoice-primitives.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": "Cynco Labs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./backend": "./src/backend.ts",
    "./schema": "./src/schema/index.ts",
    "./schema.json": "./schema/invoice-primitives.schema.json",
    "./packs/eu": "./src/packs/eu.ts",
    "./packs/jp": "./src/packs/jp.ts",
    "./packs/my": "./src/packs/my.ts",
    "./testing": "./src/testing/conformance.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./backend": {
        "types": "./dist/backend.d.ts",
        "default": "./dist/backend.js"
      },
      "./schema": {
        "types": "./dist/schema/index.d.ts",
        "default": "./dist/schema/index.js"
      },
      "./schema.json": "./schema/invoice-primitives.schema.json",
      "./packs/eu": {
        "types": "./dist/packs/eu.d.ts",
        "default": "./dist/packs/eu.js"
      },
      "./packs/jp": {
        "types": "./dist/packs/jp.d.ts",
        "default": "./dist/packs/jp.js"
      },
      "./packs/my": {
        "types": "./dist/packs/my.d.ts",
        "default": "./dist/packs/my.js"
      },
      "./testing": {
        "types": "./dist/testing/conformance.d.ts",
        "default": "./dist/testing/conformance.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "schema",
    "vectors"
  ],
  "scripts": {
    "gen:currencies": "node scripts/gen-currencies.mjs",
    "corpus": "node scripts/fetch-corpus.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mutate": "node scripts/mutate.mjs",
    "bench": "node scripts/bench.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "gen": "node scripts/gen-schema.ts"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.10.2",
    "fast-xml-parser": "^5.11.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
